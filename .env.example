# @BotFather bergan maxfiy token
BOT_TOKEN=1234567890:AAExampleReplaceWithRealToken

# Lokal ishlash uchun SQLite yetarli. Railway'da PostgreSQL DATABASE_URL ishlating.
DATABASE_URL=sqlite+aiosqlite:///./plagiai.db

# Admin Telegram IDlari, vergul bilan ajratiladi.
ADMIN_IDS=123456789

MAX_FILE_MB=20
MAX_TEXT_CHARS=200000

# Quetext Account -> API Keys bo‘limidagi maxfiy kalit.
QUETEXT_API_KEY=replace-with-quetext-api-key

# Ixtiyoriy polling sozlamalari.
QUETEXT_POLL_SECONDS=3
QUETEXT_TIMEOUT_SECONDS=240

# QR kod ochadigan public URL. Railway domeningizni https bilan kiriting.
# Masalan: https://plagiai-production.up.railway.app
# Bo‘sh qoldirilsa Railway'ning RAILWAY_PUBLIC_DOMAIN tizim o‘zgaruvchisi ishlatiladi.
PUBLIC_BASE_URL=

PORT=8080
